# Security headers for Cloudflare Pages (real hosting).
# Cache-Control no-cache: phones always check for a new version of the page itself, so they never open an old copy.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), publickey-credentials-get=(self), publickey-credentials-create=(self), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cache-Control: no-cache

# Built files have a unique name per version, so they can be kept for a year.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The notification worker must always be fresh.
/sw.js
  ! Cache-Control
  Cache-Control: no-cache
