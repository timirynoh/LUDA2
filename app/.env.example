# Copy to .env.local for local testing. Leave both empty to run the app in demo mode.
# Only PUBLIC values go here. Secret keys live in Supabase secrets, never in the app.
VITE_PAY_API=https://<your-project>.supabase.co/functions/v1   # switches on the real-money wallet
VITE_SUPABASE_ANON_KEY=   # the anon or publishable key (public, safe)
